# Скопируйте в .env и задайте свои значения (scripts/preflight.sh создаёт пустые EW_TOKEN/SWARM_KEY сам):
#   EW_TOKEN=$(openssl rand -hex 16)    SWARM_KEY=$(openssl rand -hex 16)   # SWARM_KEY — ровно 32 hex-символа
#   EW_ADMIN_TOKEN=$(openssl rand -hex 16)   # операторский: изменяющие методы РЭБ (HUD, ewctl.sh, скрипты); бортам не выдаётся
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.px4.yml:docker-compose.swarm.yml:docker-compose.hud.yml
EW_TOKEN=
EW_ADMIN_TOKEN=
SWARM_KEY=
LIBGL_ALWAYS_SOFTWARE=0
