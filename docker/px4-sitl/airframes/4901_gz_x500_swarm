#!/bin/sh
#
# @name Gazebo x500 swarm (SITL, companion-driven)
#
# @type Quadrotor
# @class Copter
#
# @maintainer swarm-sitl
#

# Базовый airframe: геометрия, моторы, SIM_GZ_*, PID
. ${R}etc/init.d-posix/airframes/4001_gz_x500

# Идентичность борта (в мульти-режиме приходит из окружения fc-N)
param set-default MAV_SYS_ID ${PX4_SYS_ID:=1}

# Поведение при потере C2 / RC (сценарии п. 2.8): рой управляется бортовыми агентами, а не оператором
param set-default NAV_DLL_ACT 0
param set-default NAV_RCL_ACT 0
param set-default COM_RC_IN_MODE 4
param set-default COM_RCL_EXCEPT 7
param set-default COM_ARM_WO_GPS 1
param set-default COM_OF_LOSS_T 1.0

# Оценка состояния при отказе GPS: высота по барометру, внешнее зрение (VIO) по скорости
param set-default EKF2_HGT_REF 0
param set-default EKF2_GPS_CTRL 7
param set-default EKF2_EV_CTRL 4
param set-default EKF2_EV_DELAY 40
param set-default EKF2_EV_NOISE_MD 1      # дисперсия берётся из сообщения VIO: z-скорость VIO практически не учитывается (см. vio_node.py)
param set-default EKF2_EVV_NOISE 0.15
param set-default EKF2_NOAID_TOUT 5000000

# Инъекция глушения GPS (патч P4): по умолчанию выключена
param set-default SIM_GPS_JAM 0
param set-default SIM_GPS_JAM_EPH 5.0

# Micro XRCE-DDS: привязка к localhost (127.0.0.1) в контейнере companion-а
param set-default UXRCE_DDS_PTCFG 1

# Смягчение предполетных чеков для SITL
param set-default EKF2_REQ_HDRIFT 5.0
param set-default EKF2_REQ_VDRIFT 5.0
param set-default COM_ARM_EKF_POS 50.0
param set-default COM_ARM_EKF_VEL 50.0
param set-default COM_ARM_EKF_YAW 50.0

# Журналы PX4 (.ulg) по умолчанию выключены. Прежнее значение 1 означало «с включения до разоружения», а не «только при взведённых»:
# за день прогонов каждый fc набрал 6,7 ГБ журналов в слое записи контейнера, вместе ~33 ГБ, диск C: заполнился и WSL завис (2026-10-27).
# Включить на время отладки PX4: PX4_SDLOG_MODE=0 (только пока взведён) в окружении fc-N.
param set-default SDLOG_MODE ${PX4_SDLOG_MODE:=-1}
